{
  "name": "nuo-agent-launcher",
  "version": "1.1.0",
  "description": "nuo agent launcher - 一个功能丰富的 Minecraft 启动器，集成版本下载、Java 自动管理、联机、AI 助手、日志系统",
  "main": "electron/main.cjs",
  "author": "nuo agent launcher",
  "license": "MIT",
  "scripts": {
    "dev:web": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -n WEB,ELECTRON -c blue,magenta \"npm:dev:web\" \"wait-on http://localhost:5173 && npm:dev:electron\"",
    "build:web": "vite build",
    "build": "npm run build:web && electron-builder --win --x64",
    "start": "cross-env NODE_ENV=production electron ."
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "axios": "^1.6.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.nuoagent.launcher",
    "productName": "nuo agent launcher",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "electronDist": "node_modules/electron/dist",
    "portable": {
      "artifactName": "nuo-agent-launcher-便携版.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "nuo-agent-launcher-安装版.exe"
    }
  }
}
